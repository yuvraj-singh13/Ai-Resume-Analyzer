# Groq API key (required) - get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key

# Optional: any Groq-hosted model id. Defaults to openai/gpt-oss-120b
# (Llama 3.3 70B was retired from Groq's free/developer tiers on 2026-08-16)
GROQ_MODEL=openai/gpt-oss-120b

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/resume_analyzer

# Server port
PORT=5000

# Comma separated list of allowed CORS origins for the React client
CLIENT_ORIGIN=http://localhost:5173
